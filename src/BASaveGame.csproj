<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BASaveGame</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Override on the command line: -p:GameDir="G:\Games\Broken Arrow" -->
    <GameDir Condition="'$(GameDir)' == ''">G:\Games\Broken Arrow</GameDir>
    <MLDir>$(GameDir)\MelonLoader</MLDir>
  </PropertyGroup>

  <!-- MelonLoader / Harmony / Il2CppInterop runtime (present after MelonLoader install) -->
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MLDir)\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MLDir)\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MLDir)\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game + Unity interop assemblies, generated by MelonLoader on first launch.
       Referenced as a set; none are copied (Private=false). -->
  <ItemGroup>
    <Reference Include="$(MLDir)\Il2CppAssemblies\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Deploy the built mod straight into the game's Mods folder. -->
  <Target Name="CopyToMods" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="Deployed $(AssemblyName).dll -> $(GameDir)\Mods" />
  </Target>

</Project>
